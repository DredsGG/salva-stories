{
  "manifest_version": 3,
  "name": "Salva Stories",
  "version": "1.8.7",
  "default_locale": "en",
  "description": "__MSG_appDesc__",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/sw.js",
    "scripts": [
      "src/sw.js"
    ],
    "type": "module"
  },
  "permissions": [
    "downloads",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*",
    "https://www.instagram.com/*",
    "https://api.github.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "src/page.js",
        "src/kit.js",
        "src/novidades/pt.js",
        "src/novidades/en.js",
        "src/novidades/es.js",
        "src/menu.js",
        "src/profile.js",
        "src/player.js",
        "src/inbox.js",
        "src/follows.js",
        "src/onboard.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "author": "Dreds",
  "homepage_url": "https://github.com/DredsGG/salva-stories",
  "browser_specific_settings": {
    "gecko": {
      "id": "salva-stories@dredsgg",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      },
      "update_url": "https://raw.githubusercontent.com/DredsGG/salva-stories/main/firefox/updates.json"
    }
  }
}
