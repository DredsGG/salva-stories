{
  "manifest_version": 3,
  "name": "Salva Stories",
  "version": "1.3.2",
  "description": "Botão para salvar o story do Instagram que está na tela: foto na resolução original, vídeo com som. Feito por Dreds.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "Salva Stories",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/sw.js",
    "type": "module"
  },
  "permissions": [
    "downloads",
    "storage"
  ],
  "host_permissions": [
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "src/page.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "author": "Dreds"
}