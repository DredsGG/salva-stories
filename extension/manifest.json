{
  "manifest_version": 3,
  "name": "Salva Stories",
  "version": "1.5.2",
  "description": "Salva stories, posts e vídeos do Instagram, player com velocidade, seleção no Direct e análise de seguidores. Feito por Dreds.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Salva Stories — ajustes no Instagram (Alt+S)",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "src/sw.js",
    "type": "module"
  },
  "permissions": [
    "downloads",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.cdninstagram.com/*",
    "https://*.fbcdn.net/*",
    "https://www.instagram.com/*",
    "https://api.github.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "src/page.js",
        "src/kit.js",
        "src/menu.js",
        "src/profile.js",
        "src/player.js",
        "src/inbox.js",
        "src/follows.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "src/bridge.js"
      ],
      "run_at": "document_start"
    }
  ],
  "author": "Dreds",
  "homepage_url": "https://github.com/DredsGG/salva-stories"
}